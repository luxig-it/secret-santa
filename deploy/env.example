# Copy to /opt/secret-santa/.env on the server and chmod 600 it.

# The release to run, without the "v": tag v1.2.0 is image 1.2.0.
# See https://github.com/luxig-it/secret-santa/releases for what exists.
SECRET_SANTA_VERSION=1.0.0

# The public address as people reach it through Plesk; it builds the links.
SECRET_SANTA_BASE_URL=https://wichteln.example.com

# The local port Plesk proxies to (bound to 127.0.0.1 only).
SECRET_SANTA_HOST_PORT=8080

# Requests reach the app from Plesk's nginx through Docker's network, so
# every visitor would look the same. Trust the X-Real-IP header nginx sets,
# but only on connections from Docker's private range.
SECRET_SANTA_TRUSTED_PROXY=172.16.0.0/12

# Generate real keys, e.g. with: openssl rand -base64 24
# The app refuses to start with this placeholder.
SECRET_SANTA_ORGANIZER_TOKENS=carsten:REPLACE-WITH-A-LONG-RANDOM-KEY

# Optional mail (see the main .env.example for the details).
#SECRET_SANTA_ALLOW_EMAIL=true
#SECRET_SANTA_SMTP_HOST=smtp.example.com
#SECRET_SANTA_SMTP_PORT=465        # 465: TLS from the start; 587: STARTTLS
#SECRET_SANTA_SMTP_USER=wichteln@example.com
#SECRET_SANTA_SMTP_PASS=
#SECRET_SANTA_SMTP_FROM=Wichteln <wichteln@example.com>
