# Public base URL of the instance. Used to build the join and participant
# links, so it must match what people type into their browser.
SECRET_SANTA_BASE_URL=http://localhost:8080

# Listen address inside the container.
SECRET_SANTA_ADDR=:8080

# SQLite database file. Put it on a volume.
SECRET_SANTA_DB=/data/secret-santa.db

# Who may create campaigns: comma separated "label:token" pairs.
# Labels must be unique: each organizer sees the campaigns filed under their
# label, so renaming one detaches its campaigns.
# Leave this empty and the app generates one on first start and prints it.
SECRET_SANTA_ORGANIZER_TOKENS=carsten:change-me,anna:change-me-too

# Optional: let people have their personal link (and organizers their
# management link) sent by mail. With ALLOW_EMAIL on, an "E-Mail" button
# appears next to the link; the typed address is used once and not stored.
# It needs SMTP_HOST and SMTP_FROM. Port 465 uses TLS from the start, any
# other port (usually 587) STARTTLS; SMTP_TLS=implicit or starttls overrides
# that. Either way the server certificate must be valid for SMTP_HOST. Without encryption nothing is sent, since the mail
# carries a secret link; SMTP_INSECURE=true allows that for a local relay or
# a test mail catcher, but a login is never sent in clear text.
#SECRET_SANTA_ALLOW_EMAIL=true
#SECRET_SANTA_SMTP_INSECURE=false
#SECRET_SANTA_SMTP_TLS=implicit
#SECRET_SANTA_SMTP_HOST=smtp.example.com
#SECRET_SANTA_SMTP_PORT=587
#SECRET_SANTA_SMTP_USER=secret-santa@example.com
#SECRET_SANTA_SMTP_PASS=
#SECRET_SANTA_SMTP_FROM=Secret Santa <secret-santa@example.com>

# Behind a reverse proxy, the addresses (IPs or CIDR ranges) whose
# X-Real-IP header names the real client. Without it every visitor shares
# the proxy's address for the login and mail limits.
#SECRET_SANTA_TRUSTED_PROXY=172.16.0.0/12
