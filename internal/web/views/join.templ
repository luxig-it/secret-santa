package views

templ Join(p JoinPage) {
	@Layout(p.Campaign.Title) {
		@CampaignHead(p.Campaign)
		@FlashBox(p.Flash)
		if p.Campaign.Drawn() {
			<section class="card">
				<p>Diese Kampagne ist bereits ausgelost, ein Beitritt ist nicht mehr möglich. Wenn du schon dabei bist, öffne deinen persönlichen Link.</p>
			</section>
		} else {
			<section class="card narrow">
				<h2>Mitmachen</h2>
				<form method="post" action={ templ.URL(joinPath(p.Campaign.JoinToken)) } class="stack">
					<label for="name">Dein Name</label>
					<input id="name" name="name" required maxlength="60" autocomplete="name" value={ p.Name } placeholder="So sehen dich die anderen"/>
					<button class="btn" type="submit">Beitreten</button>
				</form>
				<p class="hint">Schon dabei? Dann nutze deinen persönlichen Link, den du beim Beitritt bekommen hast – sonst trägst du dich doppelt ein.</p>
			</section>
		}
		@Group(p.CampaignPage, nil)
	}
}
